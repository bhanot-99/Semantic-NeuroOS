# systemd user unit (ADR-0002) for neuroos-inference [C4]
[Unit]
Description=NeuroOS neuroos-inference [C4]
PartOf=neuroos.target

[Service]
Type=simple
ExecStart=/opt/neuroos/bin/neuroos-inference

# --- hardening baseline (Architecture.md §8.1); user unit, per ADR-0002
# (spike S-01, P0-S06) ---
PrivateNetwork=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# spike S-05 (Phase 2, phases.md §5.1 item 8): verified real neuroos-inference
# --bench (model load + inference) runs to completion under `systemd-run
# --user -p MemoryDenyWriteExecute=yes` with no crash — the AVX2 ggml-cpu
# backend is pre-compiled (-march=native), no JIT, so this is safe.
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
InaccessiblePaths=-/run/systemd/resolve
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=1900M
Restart=on-failure
RestartSec=2s

# %t/neuroos holds every socket; ProtectSystem=strict would make it read-only.
RuntimeDirectory=neuroos
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
BindReadOnlyPaths=/opt/neuroos/models -%h/.config/neuroos/config.toml

[Install]
WantedBy=neuroos.target
