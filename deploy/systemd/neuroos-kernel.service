# systemd user unit (ADR-0002) for neuroos-kernel [C6]
[Unit]
Description=NeuroOS neuroos-kernel [C6]
PartOf=neuroos.target

[Service]
Type=simple
ExecStart=/opt/neuroos/bin/neuroos-kernel

# --- hardening baseline (Architecture.md §8.1); user unit, per ADR-0002
# (spike S-01, P0-S06) ---
PrivateNetwork=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
InaccessiblePaths=-/run/systemd/resolve
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=64M
Restart=on-failure
RestartSec=2s

# %t/neuroos holds every socket; ProtectSystem=strict would make it read-only.
RuntimeDirectory=neuroos
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
BindReadOnlyPaths=-%h/.config/neuroos/hmac.key -%h/.config/neuroos/config.toml
BindPaths=-%h/.local/share/neuroos/actions.jsonl

[Install]
WantedBy=neuroos.target
