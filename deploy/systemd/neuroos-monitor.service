# systemd user unit (ADR-0002) for neuroos-monitor [C1]
[Unit]
Description=NeuroOS neuroos-monitor [C1]
PartOf=neuroos.target

[Service]
Type=simple
ExecStart=/opt/neuroos/bin/neuroos-monitor

# --- hardening baseline (Architecture.md §8.1); user unit, per ADR-0002
# (spike S-01, P0-S06) ---
PrivateNetwork=true
NoNewPrivileges=true
ProtectSystem=strict
# Deviates from the shared ProtectHome=tmpfs baseline (Architecture.md §8.1):
# FR-MON-09's folder sensor needs read access to whatever git/notes/ICS
# paths the operator configures under [[monitor.folders]] in config.toml,
# which can be anywhere under $HOME and isn't known at unit-authoring time.
# read-only still blocks every write.
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
InaccessiblePaths=-/run/systemd/resolve
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=40M
Restart=on-failure
RestartSec=2s

# %t/neuroos holds every socket; ProtectSystem=strict would make it read-only.
RuntimeDirectory=neuroos
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=neuroos.target
