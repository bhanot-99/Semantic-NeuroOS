# systemd user unit (ADR-0002) for neuroos-voice [C2]
[Unit]
Description=NeuroOS neuroos-voice [C2]
PartOf=neuroos.target

[Service]
Type=simple
ExecStart=/opt/neuroos/bin/neuroos-voice

# --- hardening baseline (Architecture.md §8.1); user unit, per ADR-0002
# (spike S-01, P0-S06) ---
PrivateNetwork=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=false
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
SystemCallFilter=@system-service
InaccessiblePaths=-/run/systemd/resolve
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=520M
Restart=on-failure
RestartSec=2s

# %t/neuroos holds every socket; ProtectSystem=strict would make it read-only.
RuntimeDirectory=neuroos
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
BindReadOnlyPaths=/opt/neuroos/models/silero /opt/neuroos/models/openwakeword /opt/neuroos/models/whisper /opt/neuroos/models/kokoro -%h/.config/neuroos/config.toml

[Install]
WantedBy=neuroos.target
