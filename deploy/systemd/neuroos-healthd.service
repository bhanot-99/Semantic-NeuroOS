# systemd user unit (ADR-0002) for healthd [D]
[Unit]
Description=NeuroOS healthd [D]
PartOf=neuroos.target

[Service]
Type=simple
# '+': runs outside the sandbox, to create the bind-mount sources.
ExecStartPre=+/usr/bin/mkdir -p -m 0700 %h/.local/share/neuroos/soak
ExecStart=/opt/neuroos/bin/neuroos-healthd

# --- hardening baseline (Architecture.md §8.1); user unit, per ADR-0002
# (spike S-01, P0-S06) ---
PrivateNetwork=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
InaccessiblePaths=-/run/systemd/resolve
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=32M
Restart=on-failure
RestartSec=2s

# %t/neuroos holds every socket; ProtectSystem=strict would make it read-only.
RuntimeDirectory=neuroos
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
BindReadOnlyPaths=/sys/fs/cgroup -%h/.config/neuroos/config.toml
BindPaths=%h/.local/share/neuroos/soak

[Install]
WantedBy=neuroos.target
