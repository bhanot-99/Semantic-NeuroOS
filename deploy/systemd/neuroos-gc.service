# systemd user unit (ADR-0002): RPCs C3's GC: expire rows past retention, purge LanceDB, incremental VACUUM
# (Architecture.md §7.5) over storage.sock, via `neuroosctl storage gc`.
[Unit]
Description=NeuroOS storage GC vacuum (daily)
After=neuroos-storage.service
Requisite=neuroos-storage.service

[Service]
Type=oneshot
ExecStart=/opt/neuroos/bin/neuroosctl storage gc
